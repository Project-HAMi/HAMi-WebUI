{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "externalPrometheus": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "insecureSkipVerify": {
              "type": "boolean"
            },
            "serverName": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "caKey": {
              "type": "string"
            },
            "certKey": {
              "type": "string"
            },
            "keyKey": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
